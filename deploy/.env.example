# analyseLaptop v2 — Hub environment variables
# Copy to .env and fill in real values. NEVER commit .env to Git.
# Secrets (pg_password, jwt_secret, etc.) go in /run/analyselaptop/secrets/ — NOT here.

# Image tag deployed (set by CI to git SHA; override manually for pin)
IMAGE_TAG=latest

# Backend ingest address (used by collector enrollment script)
BACKEND_INGEST_URL=https://monitor.example.internal:4317

# Nginx public hostname (used for TLS cert and CORS)
PUBLIC_HOSTNAME=monitor.example.internal
