# Dev-only hub stack environment variables (deploy/hub/docker-compose.dev.yml).
# Copy to deploy/hub/.env if you want to override the defaults baked into
# the compose file. These are throwaway dev credentials, not production
# secrets — see docs/architecture/IaC-DEPLOYMENT-STRATEGY.md §8 for how
# production secrets are actually handled (file-based, never env vars).

POSTGRES_DB=analyselaptop
POSTGRES_USER=analyselaptop
POSTGRES_PASSWORD=dev-only-not-a-real-secret
