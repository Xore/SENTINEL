{
  "$id": "https://github.com/Xore/analyseLaptop/contracts/collector-update-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical Ed25519-signed SENTINEL v2 collector update manifest.",
  "properties": {
    "collector_version": {
      "pattern": "^2\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "min_supported_from_version": {
      "pattern": "^2\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "platform": {
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ],
      "type": "string"
    },
    "rollback": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "type": "string"
    },
    "signing_key_id": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "size_bytes": {
      "maximum": 268435456,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "collector_version",
    "expires_at",
    "min_supported_from_version",
    "not_before",
    "platform",
    "rollback",
    "schema_version",
    "sha256",
    "signature",
    "signing_key_id",
    "size_bytes"
  ],
  "title": "SENTINEL Collector Update Manifest v1",
  "type": "object"
}
